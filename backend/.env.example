# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/alumnisphere?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/alumnisphere

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Node Environment
NODE_ENV=production

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,https://alumni-sphere-2.vercel.app
